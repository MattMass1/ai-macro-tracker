# Copy to server/.env and fill in. Never commit the real file.

# Notion internal integration secret from notion.so/my-integrations.
# The integration must be added to the `Daily Food Log` page under ... > Connections.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Existing `Nutrition Entries` data source — already correct, do not change.
NUTRITION_DS_ID=a9165caa-f1ba-4a3d-9d9b-c850bd1b4c4c

# Printed by `python setup.py` after it creates/locates the two new databases.
# These are the IDs setup.py produced for this workspace — re-run it to confirm.
TARGETS_DS_ID=28558993-430c-46f8-a3b8-de298564ecf7
PRESETS_DS_ID=eb90a4df-6a7a-446f-9c1d-c566cf06cdf6

# Parent page `Daily Food Log`.
PARENT_PAGE_ID=3415aac7-7d31-8176-8d64-eb008a13e919

# Shared secret retained only for /mcp authentication. App APIs use device tokens.
APP_SHARED_TOKEN=change-me-to-a-long-random-string

# Stable UUID for Matt. If omitted, the server and migration use the same deterministic UUID.
MATT_USER_ID=
# Optional migration override for Matt's display name.
MATT_DISPLAY_NAME=Matt

# Nous inference API token used by the in-app Chat & Log parser.
NOUS_ACCESS_TOKEN=

# The coach shares OPENAI_ACCESS_TOKEN with the food parser.
OPENAI_ACCESS_TOKEN=
# Project API key used only by the server-side GPT-Live bridge.
OPENAI_API_KEY=

# Optional primary food database. Results are not cached unless explicitly enabled.
# FatSecret Basic uses OAuth 1.0 credentials and is preferred when both are set.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# FatSecret Premier OAuth2 fallback.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Must be explicitly true only when FatSecret attribution is enabled in the UI.
FATSECRET_ATTRIBUTION_ENABLED=false
FATSECRET_CACHE_ALLOWED=false
# Unknown-nutrient (calorie-only) release gates. Leave unset/false unless the
# owner approved the rollout step (docs/rollback/003_calorie_only_unknown_macros.md).
# APPROVED_MIGRATIONS=003_calorie_only_unknown_macros.sql:<sha256>
CALORIE_ONLY_WRITES_ENABLED=false
# CALORIE_ONLY_WRITES_USER_IDS=<uuid>,<uuid>

# Override only when migrating models; defaults to the fleet-selected Luna model.
COACH_MODEL=gpt-5.6-luna

# Day-boundary rule: the logging day rolls at 4am in this timezone.
LOCAL_TZ=America/New_York
DAY_ROLLOVER_HOUR=4

# Comma-separated browser origins allowed to call /api/*. `*` allows any.
ALLOWED_ORIGINS=*

# Voice provider: openai (default, GPT Realtime) or elevenlabs. Keep openai
# until the ElevenLabs path is verified on a real device.
VOICE_PROVIDER=openai
# ElevenLabs Agents voice. Only read when VOICE_PROVIDER=elevenlabs. The API key
# never leaves the server; the app receives only short-lived conversation tokens.
ELEVENLABS_API_KEY=
# The agent id printed by server/scripts/elevenlabs_agent_setup.py.
ELEVENLABS_AGENT_ID=
# Shared secret the agent_turn webhook requires (server-to-server). Also stored
# as an ElevenLabs workspace secret and sent by the agent as a request header.
ELEVENLABS_TOOL_SECRET=

# Injected by Render in production; used for local runs.
PORT=8000
