# Copy to web/.env.local. All three are server-side only — never NEXT_PUBLIC_.

# The Python service on Render (no trailing slash). Use http://localhost:8000 locally.
MACRO_API_URL=https://macro-tracker.onrender.com

# Must match APP_SHARED_TOKEN in server/.env.
APP_SHARED_TOKEN=change-me-to-a-long-random-string

# The code you type once on your iPhone to unlock the app.
APP_PASSCODE=1234
