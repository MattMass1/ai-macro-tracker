# Copy to web/.env.local. All three are server-side only — never NEXT_PUBLIC_.

# The Python service on Render (no trailing slash).
MACRO_API_URL=https://ai-macro-tracker-nuoo.onrender.com

# Must match APP_SHARED_TOKEN in server/.env.
APP_SHARED_TOKEN=change-me-to-a-long-random-string

# The code you type once on your iPhone to unlock the app.
APP_PASSCODE=1234

# Capacitor build only: set NEXT_PUBLIC_CAPACITOR=true to make a static app.
# These values are embedded in the mobile bundle; use the same token as above.
NEXT_PUBLIC_CAPACITOR=false
NEXT_PUBLIC_MACRO_API_URL=https://ai-macro-tracker-nuoo.onrender.com
NEXT_PUBLIC_APP_SHARED_TOKEN=change-me-to-the-same-mobile-build-token
NEXT_PUBLIC_APP_PASSCODE=1234
